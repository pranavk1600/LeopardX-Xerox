PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leopardx_xerox?schema=public"
CLIENT_URL="http://localhost:5173"
MAX_FILE_SIZE_MB=20
FILE_STORAGE_PATH="./uploads"

# Cashfree Test Keys (Ready for Phase 5)
CASHFREE_APP_ID="test_app_id"
CASHFREE_SECRET_KEY="test_secret_key"
CASHFREE_ENV="TEST"

# Razorpay Alternative Keys (Optional)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Cashfree Production Return URL (Must be https:// for PRODUCTION, e.g. https://your-domain.ngrok-free.app/print)
CASHFREE_RETURN_URL=""

# Print Simulation Mode (true = simulate printing, false = use real Windows printer)
PRINT_SIMULATION_MODE=true
